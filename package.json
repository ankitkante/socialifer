{
  "name": "socialifer",
  "version": "1.0.0",
  "description": "Write once, post to multiple social platforms from a single page.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --watch --env-file-if-exists=.env server.js",
    "test": "node --test",
    "youtube-auth": "node --env-file-if-exists=.env scripts/youtube-auth.js",
    "tunnel": "node --env-file-if-exists=.env scripts/tunnel.js",
    "website": "node scripts/website.js",
    "sp-mobile-app": "npm --prefix mobile start",
    "sp-mobile-apk": "npm --prefix mobile run build:apk"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  }
}
