{
  "expo": {
    "name": "Socialifer",
    "slug": "socialifer",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "socialifer",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#5b4a8b",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.socialifer.app",
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "The camera scans the pairing QR code shown by the laptop.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Photos and videos you pick are attached to your posts.",
          "microphonePermission": false
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      "./plugins/allow-http.js",
      "./plugins/arm64-only.js",
      "./plugins/app-category.js",
      "@react-native-community/datetimepicker",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-logo.png",
          "backgroundColor": "#5b4a8b",
          "imageWidth": 220
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "450e18ac-a147-44bb-b805-0bca79f5521c"
      }
    },
    "owner": "ankitkante"
  }
}
