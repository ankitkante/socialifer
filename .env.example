# Copy this file to .env and fill in only the platforms you use.
# Platforms left blank are shown greyed out on the page.

PORT=3000

# Phone app: the port it reaches this laptop on over Wi-Fi (off turns it off), and the laptop's
# Wi-Fi address if the one in the pairing QR code is wrong (e.g. a VPN or virtual adapter was picked).
# PHONE_PORT=3001
# PHONE_HOST=

# Where the server's and the phone's logs are kept (a file per month, deleted after 6 months).
# LOG_DIR=logs

# Largest file you can attach, in MB.
# MAX_UPLOAD_MB=1024

# Optional: folder containing ffmpeg.exe and ffprobe.exe, if they are not on PATH.
# With ffmpeg, videos too big for a platform are compressed for that platform.
# FFMPEG_DIR=

# Optional: the lyrics-video project folder, to make subtitles from a video with Whisper on this PC.
# Set it up first with its own README (its .venv and the one-off model download), then restart this server.
# See "Generating subtitles" in README.md. Without it, Generate is hidden and you can still upload an SRT.
# Burning subtitles into videos also needs ffmpeg.
# LYRICS_VIDEO_DIR=C:\projects\lyrics-video

# --- Public link for media (needed only for Threads and Instagram images/videos) ---
# Meta downloads media from a public URL instead of accepting uploads. `npm run tunnel` starts a
# cloudflared quick tunnel and fills this in (its address changes on every run; restart the server after).
# Only uploaded files are reachable through it.
TUNNEL_URL=

# --- X (Twitter) ---
# developer.x.com: create an app, set User authentication to "Read and write",
# then generate the Access Token and Secret (regenerate them after changing permissions).
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
# X_CHAR_LIMIT=280          # X Premium accounts can set up to 25000
# X_VIDEO_MAX_MINUTES=20    # X Premium allows longer videos

# --- Bluesky ---
# Settings > Privacy and security > App passwords. Don't use your main password.
BLUESKY_HANDLE=            # e.g. yourname.bsky.social
BLUESKY_APP_PASSWORD=
# BLUESKY_SERVICE=https://bsky.social   # change only if you use a self-hosted PDS

# --- Mastodon ---
# Preferences > Development > New application, with the write:statuses and write:media scopes.
MASTODON_INSTANCE=         # e.g. https://mastodon.social
MASTODON_ACCESS_TOKEN=
# MASTODON_CHAR_LIMIT=500

# --- Threads ---
# A Meta app with the threads_basic and threads_content_publish permissions.
THREADS_ACCESS_TOKEN=
# THREADS_USER_ID=me

# --- Instagram ---
# A Business or Creator account. Using "Instagram API with Instagram Login", grant
# instagram_business_basic and instagram_business_content_publish. Posts need at least
# one image (JPEG only) or video, plus TUNNEL_URL above.
INSTAGRAM_ACCESS_TOKEN=
# INSTAGRAM_USER_ID=me
# INSTAGRAM_GRAPH_HOST=https://graph.instagram.com   # https://graph.facebook.com for Facebook Login tokens
# INSTAGRAM_API_VERSION=v23.0

# --- YouTube ---
# Google Cloud Console: enable "YouTube Data API v3", set up the OAuth consent screen
# (publish it to "In production" or the sign-in expires after 7 days), then create an
# OAuth client ID of type "Desktop app". Paste its ID and secret here, then run
#   npm run youtube-auth
# which fills in YOUTUBE_REFRESH_TOKEN for you.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# YOUTUBE_MAX_MINUTES=15    # raise once your channel is phone-verified (up to 720)
# YOUTUBE_CATEGORY_ID=22     # 22 = People & Blogs; see YouTube's category list

# --- LinkedIn ---
# A LinkedIn app with the "Share on LinkedIn" product (w_member_social scope).
# The author URN is urn:li:person:<id>; the <id> is the "sub" value from /v2/userinfo.
# Use urn:li:organization:<id> to post as a company page (needs w_organization_social).
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
# LINKEDIN_VERSION=202510

# --- Facebook Page ---
# A long-lived Page access token with pages_manage_posts and pages_read_engagement.
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
# FACEBOOK_GRAPH_VERSION=v23.0

# --- Telegram ---
# Create a bot with @BotFather and add it as an admin of your channel.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=          # @yourchannel or a numeric chat id

# --- Discord ---
# Channel settings > Integrations > Webhooks > New webhook > Copy URL.
DISCORD_WEBHOOK_URL=
# DISCORD_GUILD_ID=        # optional, gives you a link to the posted message
